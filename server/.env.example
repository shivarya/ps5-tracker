DB_HOST=localhost
DB_PORT=3306
DB_NAME=ps5_tracker
DB_USER=root
DB_PASS=

# Shared secret required on POST/PUT/DELETE /listings and /devices/register.
# Leave empty for local dev (skips the check); set a real random value in prod.
API_KEY=

DEFAULT_PINCODE=560067

# Push notifications only fire for an in_stock transition at or below this price (INR).
# Per-listing tracked_listings.max_notify_price overrides it; 0 disables price gating.
NOTIFY_MAX_PRICE=60000
